# Plantilla de credenciales de Supabase.
#
# 1. Copia este archivo a:  .streamlit/secrets.toml
# 2. Rellena los valores con los datos de tu proyecto Supabase.
# 3. NUNCA subas secrets.toml al repositorio (ya está en .gitignore).
#
# Dónde salen los valores:
#   url             -> boton "Connect" (arriba) o Project Settings -> Data API
#   publishable_key -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
#   secret_key      -> Project Settings -> API Keys -> Secret keys -> New secret key (sb_secret_...)

[supabase]
url = "https://TU-PROYECTO.supabase.co"
publishable_key = "sb_publishable_PEGA_AQUI"

# secret_key: llave con permisos totales. Solo para la app del lado del servidor
# y scripts administrativos. NUNCA se expone en el navegador.
secret_key = "sb_secret_PEGA_AQUI"
